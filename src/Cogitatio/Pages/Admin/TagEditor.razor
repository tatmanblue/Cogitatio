@page "/a/TagEditor"
<h3>Tag Editor</h3>

@* Tag summary cards: responsive, multiple per row *@
@if (usedTags == null || !usedTags.Any())
{
    <p class="text-muted small">Loading tags...</p>
}
else
{
    <div class="tag-list d-flex flex-wrap gap-2 mb-3">
        @foreach (var kv in usedTags.OrderByDescending(t => t.Value))
        {
            <div class="tag-card d-inline-flex align-items-center">
                <span class="tag-name">@kv.Key</span>
                <span class="tag-count" title="@($"{kv.Value} usages")">@kv.Value</span>
            </div>
        }
    </div>
}

@if (AdminUserState.IsAdmin == true)
{
    @if (posts == null)
    {
        <p>Loading...</p>
    }
    else if (!posts.Any())
    {
        <p>No posts found.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
            <tr>
                <th></th>
                <th>Title</th>
                <th>Date</th>
                <th>Tags</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var post in posts)
            {
                <tr @onmouseover="() => ShowDetails(post.Id)">
                    <td></td>
                    <td>@post.Title</td>
                    <td>@post.PublishedDate.ToShortDateString()</td>
                    <td>@post.TagsDisplay</td>
                </tr>
                <tr class="bg-light" style="display: @(post.CanShowDetails ? "table-row" : "none");">
                    <td colspan="4" class="p-2">
                        <div>
                            <strong>Edit Tags:</strong>
                            <textarea @bind="post.EditableTags"
                                      @oninput="() => MarkAsChanged(post.Id)"
                                      class="form-control"
                                      rows="3"
                                      style="resize: vertical;"
                                      placeholder="Enter tags separated by commas"></textarea>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                            <div>
                                <button class="btn btn-primary btn-sm" @onclick="() => SaveTags(post.Id)">Save</button>
                                <button class="btn btn-secondary btn-sm ms-2" @onclick="() => HideDetails(post.Id)">Cancel</button>
                            </div>
                            @if (!post.ConfirmingSend)
                            {
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => RequestSend(post.Id)">Send Notification Email</button>
                            }
                            else
                            {
                                <span class="me-2 small">Resend the notification email for this post?</span>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmSend(post.Id)">Yes, Send</button>
                                <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="() => CancelSend(post.Id)">Cancel</button>
                            }
                            @if (!string.IsNullOrEmpty(post.SendEmailStatus))
                            {
                                <span class="text-success small ms-2">@post.SendEmailStatus</span>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    <div>
        <NavLink href=@General.Constants.ROUTE_ADMIN_HOME>Admin</NavLink>
    </div>
}
else
{
    <div>Redirecting to Admin Login</div>
}