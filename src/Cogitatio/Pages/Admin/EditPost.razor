@page "/a/EditPost"
@page "/a/EditPost/{Slug}"
<h3>Editing Post</h3>

@if (AdminUserState.IsAdmin)
{
    if (!string.IsNullOrEmpty(Slug))
    {
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input id="title" @bind="title" class="form-control" placeholder="Title" />
        </div>

        <div class="mb-3">
            <label for="tags" class="form-label">Tags</label>
            <input id="tags" @bind="tags" class="form-control" placeholder="Tags (comma delimited)" />
            <small class="form-text text-muted">Separate tags with commas.</small>
        </div>
        <div class="mb-3">
            <label for="excerpt" class="form-label">Summary / Excerpt <small class="text-muted">(optional — shown on the home page)</small></label>
            <textarea id="excerpt" @bind="excerpt" class="form-control" rows="2" placeholder="Brief summary displayed on the post listing page. Leave blank to auto-generate."></textarea>
        </div>
        <PostEditor @bind-Value="content"/>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-2">@errorMessage</div>
        }
        <button class="btn btn-primary mt-2" @onclick=@Update>Update</button>

        <div class="border rounded p-3 mt-4">
            <h5>Notifications</h5>
            <p class="text-muted">Resend the new-post notification email to all subscribers. No changes to the post are required.</p>
            @if (!confirmingResend)
            {
                <button class="btn btn-outline-secondary" @onclick=@RequestResend>Resend Notification Email</button>
            }
            else
            {
                <span class="me-2">Are you sure you want to resend the notification email for this post?</span>
                <button class="btn btn-danger" @onclick=@ConfirmResend>Yes, Send</button>
                <button class="btn btn-outline-secondary" @onclick=@CancelResend>Cancel</button>
            }
            @if (!string.IsNullOrEmpty(resendStatusMessage))
            {
                <div class="text-success mt-2">@resendStatusMessage</div>
            }
        </div>

        <div class="mt-3">
            <NavLink href=@General.Constants.ROUTE_ADMIN_HOME>Admin</NavLink>
        </div>
    }
    else
    {
        <div>Redirecting to Search</div>
    }

}
else
{
    <div>Redirecting to Admin Login</div>
}