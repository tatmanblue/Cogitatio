@page "/a/AddPost"

<h3>Create a new post</h3>
@if (AdminUserState.IsAdmin)
{
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input id="title" @bind="title" class="form-control" placeholder="Title" />
    </div>

    <div class="mb-3">
        <label for="tags" class="form-label">Tags</label>
        <input id="tags" @bind="tags" class="form-control" placeholder="Tags (comma delimited)" />
        <small class="form-text text-muted">Separate tags with commas.</small>
    </div>
    <div class="mb-3">
        <label for="excerpt" class="form-label">Summary / Excerpt <small class="text-muted">(optional — shown on the home page)</small></label>
        <textarea id="excerpt" @bind="excerpt" class="form-control" rows="2" placeholder="Brief summary displayed on the post listing page. Leave blank to auto-generate."></textarea>
    </div>
    <TinyMCE.Blazor.Editor
        Conf="@editorConfig"
        ApiKey="@apiKey"
        @bind-Value="content"/>
    <button class="btn btn-primary mt-2" @onclick=@Publish>Publish</button>
    <div>
        <NavLink href=@General.Constants.ROUTE_ADMIN_HOME>Admin</NavLink>
    </div>
}
else
{
    <div>Redirecting to Admin Login</div>
}

