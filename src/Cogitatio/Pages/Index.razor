@page "/"
@using Cogitatio.Shared


<PageTitle>@SiteSettings.SiteTitle</PageTitle>

<h4>Introduction</h4>

<span>
    @((MarkupString)SiteSettings.Introduction)
</span>
<p>&nbsp;</p>

<h3>Recent Posts</h3>

@if (RecentPosts.Count == 0)
{
    <p>No posts exist yet.</p>
}
else
{
    <Virtualize Items="RecentPosts" Context="post">
        <BlogPostShort PostContent="post" />
    </Virtualize>
    <div class="mt-4 border-top pt-3">
        <NavLink class="btn btn-outline-primary" href="@SearchFurtherBackUrl">
            &larr; See older posts
        </NavLink>
    </div>

}