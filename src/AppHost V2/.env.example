CogitatioAdminPassword=your-secret-password
CogitatioSiteDB=your-database-connection
CogitatioDBType=MSSQL | POSTGRES
CogitatioAnalyticsId=analytics-id
CogitatioTinyMceKey=tinymce-key
CogitatioTenantId=tenant-id
CogitatioSiteUrl=https://your-site.example.com
# Set to true to send real email (via the configured EmailService DB setting) when running locally.
# Leave false/unset so local runs never send real email regardless of that DB setting.
AllowLiveEmailInDevelopment=false